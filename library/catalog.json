    {
      "id": "clique_le_max_degree_plus_one",
      "statement": "\\forall G \\in \\mathcal{G}, \\quad \\omega(G) \\le \\Delta(G) + 1",
      "conjecture": {
        "id": "clique_le_max_degree_plus_one",
        "statement": "\\omega(G) <= \\Delta(G) + 1",
        "lhs_expr": {
          "node_type": "invariant",
          "name": "clique_number"
        },
        "rel": "<=",
        "rhs_expr": {
          "node_type": "binary_op",
          "op": "+",
          "left": {
            "node_type": "invariant",
            "name": "max_degree"
          },
          "right": {
            "node_type": "constant",
            "value": 1.0
          }
        },
        "guard_predicate": null,
        "complexity": 5,
        "metadata": {
          "origin": "known_foundational_bound",
          "novelty_status": "KNOWN_FOUNDATIONAL",
          "scope": "all finite simple undirected graphs",
          "writeup": "A clique of size \u03c9 forces each of its vertices to have at least \u03c9\u22121 neighbors. Consequently \u03c9 \u2264 \u0394+1 for every finite simple graph, including an empty graph. This familiar bound turns the cheaply computed maximum degree into a certified ceiling on clique size, which an exact clique solver can use to rule out branches that cannot improve its best witness.",
          "provenance": "degree counting using pinned genuine Mathlib finite graph definitions"
        }
      },
      "source": "library/proofs/3d0ed77fed9eb05fec363b447e8e7f384cf2f8cce90fb8765dbba2a82e1f4ebd.lean",
