    {
      "id": "clique_edges_density_bound",
      "statement": "\\forall G \\in \\mathcal{G}, \\quad \\omega(G) \\cdot \\omega(G) - (1) \\le 2 \\cdot m",
      "conjecture": {
        "id": "clique_edges_density_bound",
        "statement": "\\omega(G) \\cdot \\omega(G) - (1) <= 2 \\cdot m",
        "lhs_expr": {
          "node_type": "binary_op",
          "op": "*",
          "left": {
            "node_type": "invariant",
            "name": "clique_number"
          },
          "right": {
            "node_type": "binary_op",
            "op": "-",
            "left": {
              "node_type": "invariant",
              "name": "clique_number"
            },
            "right": {
              "node_type": "constant",
              "value": 1.0
            }
          }
        },
        "rel": "<=",
        "rhs_expr": {
          "node_type": "binary_op",
          "op": "*",
          "left": {
            "node_type": "constant",
            "value": 2.0
          },
          "right": {
            "node_type": "invariant",
            "name": "size"
          }
        },
        "guard_predicate": null,
        "complexity": 9,
        "metadata": {
          "origin": "known_foundational_bound",
          "novelty_status": "KNOWN_FOUNDATIONAL",
          "scope": "all finite simple undirected graphs",
          "writeup": "A clique of size \u03c9 contains every pair of its vertices as an edge, so the whole graph must contain at least \u03c9(\u03c9\u22121)/2 edges. The checked inequality \u03c9(\u03c9\u22121) \u2264 2m gives a global upper bound on clique size from the edge count alone. Its practical value is an inexpensive, sound pruning rule for sparse candidate subgraphs; this is a known combinatorial fact, and any solver speedup must still be measured.",
          "provenance": "degree counting using pinned genuine Mathlib finite graph definitions"
        }
      },
