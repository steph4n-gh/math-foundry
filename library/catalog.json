    {
      "id": "degree_sum_density_bound",
      "statement": "\\forall G \\in \\mathcal{G}, \\quad 2 \\cdot m \\le n \\cdot \\Delta(G)",
      "conjecture": {
        "id": "degree_sum_density_bound",
        "statement": "2 \\cdot m <= n \\cdot \\Delta(G)",
        "lhs_expr": {
          "node_type": "binary_op",
          "op": "*",
          "left": {
            "node_type": "constant",
            "value": 2.0
          },
          "right": {
            "node_type": "invariant",
            "name": "size"
          }
        },
        "rel": "<=",
        "rhs_expr": {
          "node_type": "binary_op",
          "op": "*",
          "left": {
            "node_type": "invariant",
            "name": "order"
          },
          "right": {
            "node_type": "invariant",
            "name": "max_degree"
          }
        },
        "guard_predicate": null,
        "complexity": 7,
        "metadata": {
          "origin": "known_foundational_bound",
          "novelty_status": "KNOWN_FOUNDATIONAL",
          "scope": "all finite simple undirected graphs",
          "writeup": "Every edge contributes two to the total degree, while each of the n vertices has degree at most \u0394, so 2m \u2264 n\u0394. This known density bound connects the total edge count to a local maximum degree. It provides a quick consistency check and a reusable bridge between edge-count and degree-based clique bounds; it does not assert that a new theorem was discovered.",
          "provenance": "degree counting using pinned genuine Mathlib finite graph definitions"
        }
      },
