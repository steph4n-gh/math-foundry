        _ = d * (k * (n - 2) + t) := by
          simp only [Finset.sum_const, nsmul_eq_mul,
            G.card_neighborFinset_eq_degree, d]
    change p * (d ^ 2 + a) ≤ d * (2 * m + p * (n - 2))
    rw [hrel] at hcross
    rw [← htot, hpc, hrel]
    nlinarith only [hcross]
  apply csSup_le (Set.range_nonempty hQ.eigenvalues)
  rintro _ ⟨i, rfl⟩
  by_cases hl : hQ.eigenvalues i ≤ 0
  · exact hl.trans hB
  · have hlpos : 0 < hQ.eigenvalues i := lt_of_not_ge hl
    let x : V → ℝ := ⇑(hQ.eigenvectorBasis i)
    have hx : x ≠ 0 :=
      (WithLp.ofLp_eq_zero 2).ne.2 (hQ.eigenvectorBasis.orthonormal.ne_zero i)
    have heig (w : V) :
        (G.degree w : ℝ) * x w + (∑ u ∈ G.neighborFinset w, x u) =
        hQ.eigenvalues i * x w := by
      simpa only [x, Matrix.add_mulVec, Pi.add_apply,
        G.degMatrix_mulVec_apply, G.adjMatrix_mulVec_apply,
        Pi.smul_apply, smul_eq_mul] using
        congrFun (hQ.mulVec_eigenvectorBasis i) w
    have hxzero (w : V) (hw : G.degree w = 0) : x w = 0 := by
      have hne : G.neighborFinset w = ∅ :=
        Finset.card_eq_zero.mp ((G.card_neighborFinset_eq_degree w).trans hw)
      have hmul : hQ.eigenvalues i * x w = 0 := by
        simpa [hw, hne] using (heig w).symm
      exact (mul_eq_zero.mp hmul).resolve_left (ne_of_gt hlpos)
    obtain ⟨u, hu⟩ := Function.ne_iff.mp hx
    have hduNat : 0 < G.degree u := by
      by_contra hduNot
      have hdu0 : G.degree u = 0 := by omega
      exact hu (hxzero u hdu0)
    have hdu : (0 : ℝ) < (G.degree u : ℝ) := by exact_mod_cast hduNat
    let f : V → ℝ := fun w => |x w| / (G.degree w : ℝ)
    obtain ⟨v, _, hmax⟩ :=
      Finset.exists_max_image Finset.univ f Finset.univ_nonempty
    have hfu : 0 < f u := by
      dsimp only [f]
      exact div_pos (abs_pos.mpr hu) hdu
    have hfpos : 0 < f v :=
      lt_of_lt_of_le hfu (hmax u (Finset.mem_univ u))
    have hdvNat : 0 < G.degree v := by
      by_contra hdvNot
      have hdv0 : G.degree v = 0 := by omega
      have hfzero : f v = 0 := by simp [f, hdv0]
      linarith only [hfpos, hfzero]
    have hdv : (0 : ℝ) < (G.degree v : ℝ) := by exact_mod_cast hdvNat
    have hxfd : f v * (G.degree v : ℝ) = |x v| := by
      dsimp only [f]
      exact div_mul_cancel₀ _ (ne_of_gt hdv)
    have hcoord (w : V) : |x w| ≤ f v * (G.degree w : ℝ) := by
      by_cases hw : G.degree w = 0
      · simp [hw, hxzero w hw]
      · have hdw : (0 : ℝ) < (G.degree w : ℝ) := by
          exact_mod_cast Nat.pos_of_ne_zero hw
        exact (div_le_iff₀ hdw).mp (hmax w (Finset.mem_univ w))
    have hsum : |∑ w ∈ G.neighborFinset v, x w| ≤
        f v * (∑ w ∈ G.neighborFinset v, (G.degree w : ℝ)) := by
      calc
        _ ≤ ∑ w ∈ G.neighborFinset v, |x w| :=
          Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ w ∈ G.neighborFinset v, f v * (G.degree w : ℝ) :=
          Finset.sum_le_sum (fun w _ => hcoord w)
        _ = f v * (∑ w ∈ G.neighborFinset v, (G.degree w : ℝ)) := by
          rw [Finset.mul_sum]
    have heigabs : hQ.eigenvalues i * |x v| ≤
        (G.degree v : ℝ) * |x v| +
        f v * (∑ w ∈ G.neighborFinset v, (G.degree w : ℝ)) := by
      calc
        _ = |hQ.eigenvalues i * x v| := by
          rw [abs_mul, abs_of_pos hlpos]
        _ = |(G.degree v : ℝ) * x v +
            (∑ w ∈ G.neighborFinset v, x w)| := congrArg abs (heig v).symm
        _ ≤ |(G.degree v : ℝ) * x v| +
            |∑ w ∈ G.neighborFinset v, x w| := abs_add_le _ _
        _ ≤ (G.degree v : ℝ) * |x v| +
            f v * (∑ w ∈ G.neighborFinset v, (G.degree w : ℝ)) := by
          rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg (G.degree v))]
          exact add_le_add le_rfl hsum
    have hscaled :
        (hQ.eigenvalues i * (G.degree v : ℝ)) * f v ≤
        ((G.degree v : ℝ) ^ 2 +
          ∑ w ∈ G.neighborFinset v, (G.degree w : ℝ)) * f v := by
      calc
        _ = hQ.eigenvalues i * (f v * (G.degree v : ℝ)) := by ring
        _ = hQ.eigenvalues i * |x v| := by rw [hxfd]
        _ ≤ (G.degree v : ℝ) * |x v| +
            f v * (∑ w ∈ G.neighborFinset v, (G.degree w : ℝ)) := heigabs
        _ = ((G.degree v : ℝ) ^ 2 +
            ∑ w ∈ G.neighborFinset v, (G.degree w : ℝ)) * f v := by
          rw [← hxfd]
          ring
    have hlambdad : hQ.eigenvalues i * (G.degree v : ℝ) ≤
        (G.degree v : ℝ) ^ 2 +
          ∑ w ∈ G.neighborFinset v, (G.degree w : ℝ) :=
      le_of_mul_le_mul_right hscaled hfpos
    have hmul : (hQ.eigenvalues i * p) * (G.degree v : ℝ) ≤
        (2 * m + p * (n - 2)) * (G.degree v : ℝ) := by
      calc
        _ = p * (hQ.eigenvalues i * (G.degree v : ℝ)) := by ring
        _ ≤ p * ((G.degree v : ℝ) ^ 2 +
            ∑ w ∈ G.neighborFinset v, (G.degree w : ℝ)) :=
          mul_le_mul_of_nonneg_left hlambdad hp.le
        _ ≤ (G.degree v : ℝ) * (2 * m + p * (n - 2)) := hrow v
        _ = (2 * m + p * (n - 2)) * (G.degree v : ℝ) := mul_comm _ _
    have hlin : hQ.eigenvalues i * p ≤ 2 * m + p * (n - 2) :=
      le_of_mul_le_mul_right hmul hdv
    calc
      hQ.eigenvalues i ≤ (2 * m + p * (n - 2)) / p := (le_div_iff₀ hp).2 hlin
      _ = B := by
        dsimp only [B]
        field_simp [ne_of_gt hp] <;> ring

end MathFoundry.Archive.das_signless_laplacian_order_size
