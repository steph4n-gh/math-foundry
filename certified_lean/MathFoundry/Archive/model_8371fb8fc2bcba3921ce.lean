theorem model_8371fb8fc2bcba3921ce {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (h_guard : ((Fintype.card V : ℝ) ≥ (19999999 / 10000000 : ℝ))) :
    (((3 : ℝ) * (Fintype.card V : ℝ)) * ((G.cliqueFinset 3).card : ℝ)) ≥ (((G.edgeFinset.card : ℝ) * (((4 : ℝ) * (G.edgeFinset.card : ℝ)) - ((Fintype.card V : ℝ) ^ 2))) + ((((Fintype.card V : ℝ) * ((G.maxDegree : ℝ) - (if Fintype.card V = 0 then (0 : ℝ) else (2 : ℝ) * (G.edgeFinset.card : ℝ) / (Fintype.card V : ℝ)))) ^ 2) / ((Fintype.card V : ℝ) - (1 : ℝ)))) := by
  classical
  let E : Finset (V × V) := Finset.univ.filter (fun e => G.Adj e.1 e.2)
  let P : Finset ((V × V) × V) := Finset.univ.filter (fun p =>
    G.Adj p.1.1 p.1.2 ∧ G.Adj p.1.1 p.2 ∧ G.Adj p.1.2 p.2)
  let f : ((V × V) × V) → Finset V := fun p => {p.1.1, p.1.2, p.2}
  have hEcard : E.card = 2 * G.edgeFinset.card := by
    simpa [E] using G.two_mul_card_edgeFinset.symm
  have hmap : ∀ p ∈ P, f p ∈ G.cliqueFinset 3 := by
    intro p hp
    apply SimpleGraph.mem_cliqueFinset_iff.mpr
    change G.IsNClique 3 {p.1.1, p.1.2, p.2}
    apply SimpleGraph.is3Clique_triple_iff.mpr
    simpa [P] using hp
  have hfiber : ∀ s ∈ G.cliqueFinset 3,
      (P.filter (fun p => f p = s)).card ≤ 6 := by
    intro s hs
    obtain ⟨a, b, c, hab, hac, hbc, rfl⟩ :=
      SimpleGraph.is3Clique_iff.mp (SimpleGraph.mem_cliqueFinset_iff.mp hs)
    let l : List ((V × V) × V) :=
      [((a, b), c), ((a, c), b), ((b, a), c),
        ((b, c), a), ((c, a), b), ((c, b), a)]
    have hsub : P.filter (fun p => f p = {a, b, c}) ⊆ l.toFinset := by
      rintro ⟨⟨x, y⟩, z⟩ hp
      have hxyz : G.Adj x y ∧ G.Adj x z ∧ G.Adj y z := by
        simpa [P] using (Finset.mem_filter.mp hp).1
      have he : ({x, y, z} : Finset V) = {a, b, c} := by
        simpa [f] using (Finset.mem_filter.mp hp).2
      have hx : x ∈ ({a, b, c} : Finset V) := by
        rw [← he]
        simp
      have hy : y ∈ ({a, b, c} : Finset V) := by
        rw [← he]
        simp
      have hz : z ∈ ({a, b, c} : Finset V) := by
        rw [← he]
        simp
      have hxy : x ≠ y := hxyz.1.ne
      have hxz : x ≠ z := hxyz.2.1.ne
      have hyz : y ≠ z := hxyz.2.2.ne
      simp only [Finset.mem_insert, Finset.mem_singleton] at hx hy hz
      rcases hx with rfl | rfl | rfl <;>
        rcases hy with rfl | rfl | rfl <;>
        rcases hz with rfl | rfl | rfl <;>
        first
        | exact (hxy rfl).elim
        | exact (hxz rfl).elim
        | exact (hyz rfl).elim
        | simp [l]
    calc
      (P.filter (fun p => f p = {a, b, c})).card ≤ l.toFinset.card :=
        Finset.card_le_card hsub
      _ ≤ l.length := l.toFinset_card_le
      _ = 6 := rfl
  have hPbound : P.card ≤ 6 * (G.cliqueFinset 3).card := by
    calc
      P.card = ∑ s ∈ G.cliqueFinset 3, (P.filter (fun p => f p = s)).card :=
        Finset.card_eq_sum_card_fiberwise hmap
      _ ≤ ∑ _s ∈ G.cliqueFinset 3, 6 :=
        Finset.sum_le_sum (fun s hs => hfiber s hs)
      _ = 6 * (G.cliqueFinset 3).card := by simp [Nat.mul_comm]
  have hPcard : P.card = ∑ e ∈ E,
      (G.neighborFinset e.1 ∩ G.neighborFinset e.2).card := by
    calc
      P.card = ∑ _p ∈ P, (1 : ℕ) := Finset.card_eq_sum_ones P
      _ = ∑ e ∈ E, ∑ _z ∈ G.neighborFinset e.1 ∩ G.neighborFinset e.2,
          (1 : ℕ) :=
        Finset.sum_finset_product P E
          (fun e => G.neighborFinset e.1 ∩ G.neighborFinset e.2)
          (by intro p; simp [P, E, and_assoc])
      _ = ∑ e ∈ E, (G.neighborFinset e.1 ∩ G.neighborFinset e.2).card := by
        simp
  have hd1 : (∑ e ∈ E, G.degree e.1) = ∑ v : V, G.degree v ^ 2 := by
    calc
      (∑ e ∈ E, G.degree e.1) = ∑ v : V, ∑ _w ∈ G.neighborFinset v,
          G.degree v :=
        Finset.sum_finset_product E Finset.univ (fun v => G.neighborFinset v)
          (by intro p; simp [E])
      _ = ∑ v : V, G.degree v ^ 2 := by simp [pow_two]
  have hd2 : (∑ e ∈ E, G.degree e.2) = ∑ v : V, G.degree v ^ 2 := by
    calc
      (∑ e ∈ E, G.degree e.2) = ∑ v : V, ∑ _w ∈ G.neighborFinset v,
          G.degree v :=
        Finset.sum_finset_product_right E Finset.univ (fun v => G.neighborFinset v)
          (by intro p; simp [E, SimpleGraph.adj_comm])
      _ = ∑ v : V, G.degree v ^ 2 := by simp [pow_two]
  have hcommon (v w : V) : G.degree v + G.degree w ≤ Fintype.card V +
      (G.neighborFinset v ∩ G.neighborFinset w).card := by
    have hc := Finset.card_union_add_card_inter (G.neighborFinset v)
      (G.neighborFinset w)
    have hu : (G.neighborFinset v ∪ G.neighborFinset w).card ≤ Fintype.card V := by
      simpa only [Finset.card_univ] using
        Finset.card_le_card
          (Finset.subset_univ (G.neighborFinset v ∪ G.neighborFinset w))
    simp only [G.card_neighborFinset_eq_degree] at hc
    omega
  have hNat : 2 * (∑ v : V, G.degree v ^ 2) ≤
      2 * Fintype.card V * G.edgeFinset.card + 6 * (G.cliqueFinset 3).card := by
    calc
      2 * (∑ v : V, G.degree v ^ 2) =
          ∑ e ∈ E, (G.degree e.1 + G.degree e.2) := by
        rw [Finset.sum_add_distrib, hd1, hd2]
        omega
      _ ≤ ∑ e ∈ E, (Fintype.card V +
          (G.neighborFinset e.1 ∩ G.neighborFinset e.2).card) :=
        Finset.sum_le_sum (fun e _ => hcommon e.1 e.2)
      _ = 2 * Fintype.card V * G.edgeFinset.card + P.card := by
        rw [Finset.sum_add_distrib, ← hPcard]
        simp [hEcard] <;> ring
      _ ≤ 2 * Fintype.card V * G.edgeFinset.card +
          6 * (G.cliqueFinset 3).card := Nat.add_le_add_left hPbound _
  have hNatSimple : (∑ v : V, G.degree v ^ 2) ≤
      Fintype.card V * G.edgeFinset.card + 3 * (G.cliqueFinset 3).card := by
    nlinarith only [hNat]
  let n : ℝ := Fintype.card V
  let m : ℝ := G.edgeFinset.card
  let d : ℝ := G.maxDegree
  let t : ℝ := (G.cliqueFinset 3).card
  let q : ℝ := ∑ v : V, (G.degree v : ℝ) ^ 2
  have hbase : q ≤ n * m + 3 * t := by
    dsimp only [q, n, m, t]
    exact_mod_cast hNatSimple
  have hn1 : (1 : ℝ) < n := by
    dsimp only [n]
    linarith only [h_guard]
  have hnpos : (0 : ℝ) < n := lt_trans zero_lt_one hn1
  have hnz : n ≠ 0 := ne_of_gt hnpos
  have hnNat : 0 < Fintype.card V := by
    have hc : (0 : ℝ) < (Fintype.card V : ℝ) := hnpos
    exact_mod_cast hc
  have hcard0 : Fintype.card V ≠ 0 := Nat.ne_of_gt hnNat
